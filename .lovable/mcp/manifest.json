{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "podiverzum-mcp",
      "version": "0.2.0",
      "title": "Podiverzum – Magyar podcast katalógus"
    },
    "tools": [
      {
        "name": "search_podcasts",
        "title": "Podcast keresés",
        "description": "Magyar podcastok keresése név/leírás alapján a podiverzum.hu katalógusban. Visszaadja a slug, cím, kategória, rank és publikus URL adatokat.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keresőkifejezés (podcast név vagy téma)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max találatszám (alap: 15)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_podcast",
        "title": "Podcast részletek",
        "description": "Egy podcast teljes adatai slug alapján, a legutóbbi 10 epizóddal együtt.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Podcast slug (pl. 'partizan-podcast')."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_episodes",
        "title": "Epizód keresés",
        "description": "Magyar podcast epizódok szemantikus + kulcsszavas keresése (search-hybrid v13). Címre, leírásra és tartalomra keres. Átirat-részletet nem ad vissza; részletes kontextushoz használd a `get_episode_context` tool-t.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keresőkifejezés."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "Max találat (alap: 10)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_toplist",
        "title": "Podiverzum toplista",
        "description": "A Podiverzum aktuális magyar podcast toplistája (Apple + Spotify + YouTube fúzió, RRF-alapú).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max találatszám (alap: 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "find_mentions",
        "title": "Említések keresése (személy / szervezet)",
        "description": "Megkeresi azokat a magyar podcast epizódokat, amelyekben egy kanonikus, publikus személy vagy szervezet említésre kerül. Rövid, metaadatból kinyert bizonyíték-kifejezést ad (NEM szó szerinti átirat-idézetet) és publikus Podiverzum URL-eket a hivatkozáshoz.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "entity": {
              "type": "string",
              "minLength": 2,
              "description": "Személy vagy szervezet neve (ékezetek/kisbetű mindegy)."
            },
            "entity_type": {
              "type": "string",
              "enum": [
                "auto",
                "person",
                "organization"
              ],
              "description": "Entitás típusa (alap: auto — a legerősebb biztonságos találat)."
            },
            "date_from": {
              "type": "string",
              "minLength": 4,
              "description": "Legkorábbi megjelenés ISO dátumként (pl. 2026-01-01)."
            },
            "date_to": {
              "type": "string",
              "minLength": 4,
              "description": "Legkésőbbi megjelenés ISO dátumként."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "Max találat (alap: 10)."
            }
          },
          "required": [
            "entity"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_episode_context",
        "title": "Epizód publikus kontextus",
        "description": "Egy Podiverzum epizód biztonságos, publikus kontextusa (összefoglaló, személyek, szervezetek, témák) grounding célra. Átiratot vagy átirat-részletet NEM ad vissza.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "episode": {
              "type": "string",
              "minLength": 3,
              "description": "Epizód azonosító (UUID) VAGY Podiverzum URL / 'podcast-slug/epizod-slug' útvonal (pl. https://podiverzum.hu/podcast/partizan-podcast/valami)."
            }
          },
          "required": [
            "episode"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
